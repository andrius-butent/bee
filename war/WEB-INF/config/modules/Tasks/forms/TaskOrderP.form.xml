                                        <Table kind="controls">
                                            <col index="0" cellStyle="&col;"/>
                                            <col index="2" cellStyle="&col;"/>

                                            <row>
                                                <Label for="PaperEnvelope" class="bee-required"/>
                                                <ListBox source="PaperEnvelope" name="PaperEnvelope"
                                                         style="width: 175px;" required="true">
