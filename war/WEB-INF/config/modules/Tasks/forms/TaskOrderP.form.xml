                                                <ListBox source="MaterialType" name="MaterialType"
                                                         style="width: 220px;"/>
                                            </row>

                                            <row>
                                                <Label for="PaperEnvelopeNote"/>
                                                <cell colSpan="3">
                                                    <InputArea source="PaperEnvelopeNote" style="min-width: 495px;max-width: 495px;
                                min-height: 57px; max-height: 57px;"/>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="Color1" class="bee-required"/>
                                                <ListBox source="Color1" style="width: 175px;" required="true">
                                                    <item>4</item>
                                                    <item>8</item>
                                                    <item>UV</item>
                                                    <item>Nesvarbu</item>
                                                </ListBox>
                                            </row>

                                            <row>
                                                <Label for="ColorNote"/>
                                                <cell colSpan="3">
                                                    <InputArea source="ColorNote" style="min-width: 495px;max-width: 495px;
                                min-height: 57px; max-height: 57px;"/>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="Laminate1"/>
                                                <ListBox source="Laminate1" style="width: 175px;">
                                                    <item>Eko MAT</item>
                                                    <item>GLOSS</item>
                                                    <item>Grindų</item>
                                                    <item>Dekoratyvinis</item>
                                                    <item>290</item>
                                                    <item>215</item>
                                                    <item>Kita</item>
                                                </ListBox>
                                            </row>

                                            <row>
                                                <Label for="ProductFormat" class="bee-required"/>
                                                <cell colSpan="3">
                                                    <InputText source="ProductFormat" style="width: 100%;"
                                                               autocomplete="true"
                                                               required="true" maxLength="94"/>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="Quantity" class="bee-required"/>
                                                <FlowPanel>
                                                    <InputInteger source="Quantity" minValue="0" maxValue="999999"
                                                                  required="true"
                                                                  style="width: 80px; &inline;"/>
                                                    <Label text="vnt" style="&inline; margin-left: 5px;"/>
                                                </FlowPanel>
                                            </row>

                                            <row>
                                                <Label for="Note"/>
                                                <cell colSpan="3">
                                                    <InputArea source="Note" style="min-width: 495px;max-width: 495px;
                                min-height: 57px; max-height: 57px;"/>
                                                </cell>
                                            </row>
                                        </Table>
                                    </FlowPanel>
                                </Disclosure>

                                <Disclosure open="false" style="margin-top: 2ex;">
                                    <Label text="APDAILA"/>
                                    <FlowPanel>
                                        <Table kind="controls">
                                            <col index="0" cellStyle="&col1;"/>
                                            <col index="2" cellStyle="&col;"/>
                                            <col index="4" cellStyle="&col;"/>

                                            <row>
                                                <Label for="DecorationSupplier"/>
                                                <cell colSpan="5">
                                                    <DataSelector source="DecorationSupplier" style="width: 495px;"/>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="PriceSeries"/>
                                                <InputText source="PriceSeries" style="width: 100px;"/>

                                                <Label for="Number"/>
                                                <cell colSpan="3">
                                                    <FlowPanel>
                                                        <InputText source="Number" style="&inline; width: 105px;"/>

                                                        <Label for="Date"
                                                               style="&inline; margin-right: 5px; margin-left: 15px;"/>
                                                        <InputDate source="Date" style="&inline; width: 105px;"/>
                                                    </FlowPanel>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="DecorationPrice"/>
                                                <FlowPanel>
                                                    <InputMoney source="DecorationPrice" maxValue="999999.9999"
                                                                maxLength="11"
                                                                style="width: 100px; &inline;"
                                                                scale="4" placeholder="999999.9999"/>
                                                    <Label text="EUR" style="&inline; margin-left: 5px;"/>
                                                </FlowPanel>

                                                <Label for="DecorationSupplierNote"/>
                                                <cell colSpan="3">
                                                    <InputText source="DecorationSupplierNote" style="width: 280px;"/>
                                                </cell>
                                            </row>
                                        </Table>

                                        <Table kind="controls">
                                            <col index="0" cellStyle="&col1;"/>

                                            <row>
                                                <Label for="Holes"/>
                                                <ListBox source="Holes" style="width: 165px; &inline;">
                                                    <item>žiedai visu perimetru</item>
                                                    <item>žiedai kitaip</item>
                                                    <item>kita</item>
                                                </ListBox>
                                                <InputText source="OtherHoles"
                                                           style="&inline; width: 325px; margin-left: 5px;"/>
                                            </row>

                                            <row>
                                                <Label for="BendingPA"/>
                                                <cell colSpan="4">
                                                    <FlowPanel>
                                                        <ListBox source="BendingPA" style="width: 165px;">
                                                            <item>lenkimas, litavimas perimetru</item>
                                                            <item>ploteriavimas</item>
                                                            <item>klijavimas ant paviršiaus</item>
                                                            <item>apipjaunama</item>
                                                            <item>montažas į teleskopinę</item>
                                                            <item>roll-up</item>
                                                            <item>šviesdėžė</item>
                                                            <item>kita</item>
                                                        </ListBox>

                                                        <InputText source="OtherBendingPA"
                                                                   style="&inline; width: 325px; margin-left: 5px;"/>
                                                    </FlowPanel>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="BendingPB"/>
                                                <cell colSpan="4">
                                                    <FlowPanel>
                                                        <ListBox source="BendingPB" style="width: 165px;">
                                                            <item>lenkimas, litavimas perimetru</item>
                                                            <item>ploteriavimas</item>
                                                            <item>klijavimas ant paviršiaus</item>
                                                            <item>apipjaunama</item>
                                                            <item>montažas į teleskopinę</item>
                                                            <item>roll-up</item>
                                                            <item>šviesdėžė</item>
                                                            <item>kita</item>
                                                        </ListBox>

                                                        <InputText source="OtherBendingPB"
                                                                   style="&inline; width: 325px; margin-left: 5px;"/>
                                                    </FlowPanel>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="BendingPC"/>
                                                <cell colSpan="4">
                                                    <FlowPanel>
                                                        <ListBox source="BendingPC" style="width: 165px;">
                                                            <item>lenkimas, litavimas perimetru</item>
                                                            <item>ploteriavimas</item>
                                                            <item>klijavimas ant paviršiaus</item>
                                                            <item>apipjaunama</item>
                                                            <item>montažas į teleskopinę</item>
                                                            <item>roll-up</item>
                                                            <item>šviesdėžė</item>
                                                            <item>kita</item>
                                                        </ListBox>

                                                        <InputText source="OtherBendingPC"
                                                                   style="&inline; width: 325px; margin-left: 5px;"/>
                                                    </FlowPanel>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="GlueNote"/>
                                                <cell colSpan="2">
                                                    <InputArea source="GlueNote" style="min-width: 495px;max-width: 495px;
                                min-height: 57px; max-height: 57px;"/>
                                                </cell>
                                            </row>
                                        </Table>

                                        <Table kind="controls">
                                            <col index="0" cellStyle="&col1;"/>
                                            <col index="2" cellStyle="&col1;"/>

                                            <row>
                                                <Label for="Packing"/>
                                                <ListBox source="Packing" style="width: 165px; &inline;">
                                                    <item>į dėžes</item>
                                                    <item>į vakuumą</item>
                                                    <item>į popierių</item>
                                                    <item>į ruloną, strec, maketas</item>
                                                    <item>lankstyti, maketas</item>
                                                    <item>strec</item>
                                                    <item>burbulinė</item>
                                                    <item>kartonas, (kurjeriams)</item>
                                                    <item>kita</item>
                                                </ListBox>
                                                <Label for="Total" style="&inline; margin-right: 5px;"/>
                                                <InputText source="Total" style="&inline; width: 140px;"/>
                                            </row>

                                            <row>
                                                <Label text="Pastaba"/>
                                                <cell colSpan="3">
                                                    <InputArea source="OtherPacking" style="min-width: 495px;max-width: 495px;
                                min-height: 57px; max-height: 57px;"/>
                                                </cell>
                                            </row>
                                        </Table>
                                    </FlowPanel>
                                </Disclosure>

                                <Disclosure open="false" style="margin-top: 2ex;">
                                    <Label text="KAINA"/>
                                    <FlowPanel>
                                        <Table kind="controls">
                                            <col index="0" cellStyle="&col;"/>
                                            <col index="2" cellStyle="&col;"/>
                                            <col index="4" cellStyle="&col;"/>

                                            <row>
                                                <Label text="SPAUDA Tiekėjas"/>
                                                <cell colSpan="3">
                                                    <DataSelector source="Supplier" readOnly="true"
                                                                  style="width: 100%;"/>
                                                </cell>

                                                <Label for="Price"/>
                                                <InputMoney source="Price" readOnly="true" style="width: 100px;"/>
                                            </row>

                                            <row>
                                                <Label for="PressSeries"/>
                                                <InputText source="PressSeries" readOnly="true" style="width: 100px;"/>

                                                <Label for="PressNumber"/>
                                                <InputText source="PressNumber" readOnly="true"
                                                           style="&inline; width: 100px;"/>

                                                <Label for="PressDate"
                                                       style="&inline; margin-left: 50px; margin-right: 5px;"/>
                                                <InputDate source="PressDate" readOnly="true"
                                                           style="&inline; width: 100px;"/>
                                            </row>

                                            <row>
                                                <Label text="APDAILA Tiekėjas"/>
                                                <cell colSpan="3">
                                                    <DataSelector source="DecorationSupplier" readOnly="true"
                                                                  style="width: 100%;"/>
                                                </cell>

                                                <Label for="DecorationPrice"/>
                                                <InputMoney source="DecorationPrice" readOnly="true"
                                                            style="width: 100px;"/>
                                            </row>

                                            <row>
                                                <Label for="PriceSeries"/>
                                                <InputText source="PriceSeries" readOnly="true" style="width: 100px;"/>

                                                <Label for="Number"/>
                                                <InputText source="Number" readOnly="true"
                                                           style="&inline; width: 100px;"/>

                                                <Label for="Date"
                                                       style="&inline; margin-left: 50px; margin-right: 5px;"/>
                                                <InputDate source="Date" readOnly="true"
                                                           style="&inline; width: 100px;"/>
                                            </row>

                                            <row>
                                                <Label for="InvoiceSupplier"/>
                                                <cell colSpan="3">
                                                    <ListBox source="InvoiceSupplier" style="width: 100%;">
                                                        <item>DRM</item>
                                                        <item>QPA</item>
                                                    </ListBox>
                                                </cell>

                                                <Label for="InvoicePrice"/>
                                                <InputMoney source="InvoicePrice" style="width: 100px;"/>
                                            </row>

                                            <row>
                                                <Label for="InvoiceNote"/>
                                                <cell colSpan="5">
                                                    <InputText source="InvoiceNote" style="width: 495px;"/>
                                                </cell>
                                            </row>

                                            <row>
                                                <Label for="InvoiceSeries"/>
                                                <InputText source="InvoiceSeries" style="width: 100px;"/>

                                                <Label for="InvoiceNumber"/>
                                                <InputText source="InvoiceNumber" style="&inline; width: 100px;"/>

                                                <Label for="InvoiceDate"
                                                       style="&inline; margin-left: 50px; margin-right: 5px;"/>
                                                <InputDate source="InvoiceDate" style="&inline; width: 100px;"/>
                                            </row>

                                            <row>
                                                <Label for="Transportation"/>
