                                                    <item>Tentas</item>
                                                    <item>Drobė</item>
                                                    <item>Kompozitas</item>
                                                    <item>Backlight</item>
                                                    <item>Roll-up pilka kita pusė</item>
                                                    <item>Plastikas</item>
                                                    <item>Interjerinės medžiagos</item>
                                                    <item>Popierius</item>
                                                    <item>Vokai</item>
                                                    <item>Užsakovo</item>
                                                    <item>Kita</item>
                                                </ListBox>

